{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint extensions workers/clef/src workers/clef/test --max-warnings=373 --quiet && npm --prefix workers/clef run lint",
    "lint:report": "oxlint extensions workers/clef/src workers/clef/test",
    "test:extensions": "find extensions -name \"*.test.ts\" -print0 | xargs -0 node --experimental-strip-types --test",
    "test": "npm run test:extensions && npm --prefix workers/clef test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsrs --noEmit -p tsconfig.json && tsrs --noEmit -p workers/clef/tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@jitl/quickjs-ng-wasmfile-release-asyncify": "0.32.0",
    "@sebastianwessel/quickjs": "3.1.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@oxlint/plugins": "1.73.0",
    "@types/node": "24.19.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.73.0",
    "tsrs": "7.1.0-beta.tsrs4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/*/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "pi-subagents": {
    "agents": [
      "./agents"
    ]
  }
}
