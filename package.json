{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/*/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "pi-subagents": {
    "agents": [
      "./agents"
    ]
  },
  "dependencies": {
    "@jitl/quickjs-ng-wasmfile-release-asyncify": "0.32.0",
    "@sebastianwessel/quickjs": "3.1.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.73.0",
    "oxlint": "1.73.0",
    "typebox": "1.3.27"
  },
  "scripts": {
    "lint": "oxlint extensions workers/clef/src workers/clef/test --max-warnings=193 --quiet && npm --prefix workers/clef run lint",
    "lint:report": "oxlint extensions workers/clef/src workers/clef/test",
    "test:extensions": "find extensions -name \"*.test.ts\" -print0 | xargs -0 node --experimental-strip-types --test",
    "test": "npm run test:extensions && npm --prefix workers/clef test",
    "check": "npm run lint && npm run test && npm --prefix workers/clef run format:check && npm --prefix workers/clef run typecheck"
  }
}
