{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-clef",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "ai": {
    "binding": "WORKERS_AI",
  },
  "vars": {
    "AI_GATEWAY_ID": "default",
  },
  "observability": {
    "enabled": false,
  },
}
