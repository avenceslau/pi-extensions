{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "vitest", "promise", "node"],
  "env": {
    "builtin": true,
    "browser": true,
    "es2021": true,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "style": "off",
    "perf": "warn"
  },
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "node_modules/**",
    "dist/**",
    ".wrangler/**"
  ],
  "jsPlugins": [
    {
      "name": "durability",
      "specifier": "@durability/lint"
    }
  ],
  "rules": {
    "no-unused-vars": "error",
    "no-await-in-loop": "off",
    "eqeqeq": "warn",
    "no-undef": "warn",
    "no-empty": "warn",
    "no-console": "off",
    "curly": "warn",
    "no-debugger": "warn",
    "no-underscore-dangle": "warn",
    "no-unreachable": "warn",
    "@typescript-eslint/no-explicit-any": "warn",
    "vitest/require-mock-type-parameters": "off",
    "durability/alarm-runner-only": "error",
    "durability/durability-migrations-only": "error",
    "durability/transform-next-once": "error"
  }
}
