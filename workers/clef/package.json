{
  "name": "pi-clef",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src test",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "jose": "6.2.18",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "@durability/lint": "0.4.0",
    "@types/node": "^24.0.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.73.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "wrangler": "4.166.0"
  }
}
